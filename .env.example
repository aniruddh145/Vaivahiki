# PostgreSQL connection string (Railway / Render / Neon / Supabase give you this)
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Set to "true" if your database host requires SSL (Neon, Supabase, Render external URL)
DATABASE_SSL="false"
# Long random text – keeps logins secure. Generate: openssl rand -hex 32
SESSION_SECRET=""
# Public address of the site
APP_URL="https://vivah.example.org"
# Folder for uploaded photos. Mount a persistent disk/volume here in production.
UPLOAD_DIR="/data/uploads"
# First admin account (used only by `npm run db:seed`)
ADMIN_MOBILE="+919999999999"
ADMIN_PASSWORD="change-this-now"
ADMIN_EMAIL=""
# Optional – can instead be entered in Admin → Settings
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Vercel only – added automatically when you connect a Blob store
BLOB_READ_WRITE_TOKEN=""
# Optional – AI spam check key (can instead be entered in Admin → Settings → Spam & moderation)
MODERATION_API_KEY=""
